# Existing PostgreSQL server (not created by this compose file)
POSTGRES_HOST=homepostgresql-db
POSTGRES_PORT=5432
POSTGRES_USER=home
POSTGRES_PASSWORD=
POSTGRES_DB=home

# Price area used by elprisenligenu (DK1 west, DK2 east / Copenhagen)
PRISKLASSE=DK2

# FastHTML listen address inside the container
WEB_HOST=0.0.0.0
WEB_PORT=8089
TZ=Europe/Copenhagen

# Secret iCal address for one Google calendar (read-only, not stored).
# Google Calendar → Settings → that calendar → Integrate calendar → Secret address in iCal format.
GOOGLE_CALENDAR_ICS_URL=
